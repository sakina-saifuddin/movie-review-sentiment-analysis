      "source": [
        "## 8. Define evaluation functions\n",
        "\n",
        "Compare predictions against actual test labels. Report a confusion matrix and precision, recall, and F1 for both classes."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a5db33e4",
      "metadata": {
        "id": "a5db33e4"
      },
      "outputs": [],
      "source": [
        "def build_confusion_matrix(actual_labels, predicted_labels):\n",
        "    # Rows = actual class; columns = predicted class.\n",
        "    matrix = [[0, 0], [0, 0]]\n",
        "\n",
        "    for actual, predicted in zip(actual_labels, predicted_labels):\n",
        "        matrix[int(actual)][int(predicted)] += 1\n",
        "\n",
        "    return pd.DataFrame(\n",
        "        matrix,\n",
        "        index=[\"Actual Negative\", \"Actual Positive\"],\n",
        "        columns=[\"Predicted Negative\", \"Predicted Positive\"]\n",
        "    )\n",
        "\n",
        "def calculate_metrics(confusion):\n",
        "    rows = []\n",
        "\n",
        "    for label, class_name in [(0, \"Negative\"), (1, \"Positive\")]:\n",
        "        # Diagonal entry: correct predictions for this class.\n",
        "        correct = confusion.iloc[label, label]\n",
        "\n",
        "        # Column total: all predictions of this class.\n",
        "        predicted_total = confusion.iloc[:, label].sum()\n",
        "\n",
        "        # Row total: all actual reviews of this class.\n",
        "        actual_total = confusion.iloc[label, :].sum()\n",
        "\n",
        "        # Use zero when a denominator is zero.\n",
        "        precision = correct / predicted_total if predicted_total else 0.0\n",
        "        recall = correct / actual_total if actual_total else 0.0\n",
        "\n",
        "        f1 = (\n",
        "            2 * precision * recall / (precision + recall)\n",
        "            if precision + recall else 0.0\n",
        "        )\n",
        "\n",
        "        rows.append({\n",
        "            \"Class\": class_name,\n",
        "            \"Precision\": precision,\n",
        "            \"Recall\": recall,\n",
        "            \"F1\": f1\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(rows)"
      ]
    },
