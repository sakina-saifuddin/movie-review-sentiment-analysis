        ")\n",
        "\n",
        "# Select 200 positive reviews from the remaining data.\n",
        "test_positive = remaining_df[remaining_df[\"label\"] == 1].sample(\n",
        "    n=200, replace=False, random_state=42\n",
        ")\n",
        "\n",
        "# Combine the two groups and shuffle their order.\n",
        "test_df = pd.concat([test_negative, test_positive])\n",
