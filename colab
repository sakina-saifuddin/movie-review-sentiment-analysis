        "## 6. Define the training functions\n",
        "\n",
        "Priors count training reviews in each class. Token counts build a training-only vocabulary. Likelihoods use add-1 Laplace smoothing."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e8c726dd",
      "metadata": {
        "id": "e8c726dd"
      },
      "outputs": [],
      "source": [
        "from collections import Counter\n",
        "\n",
        "def calculate_priors(labels):\n",
        "    # Count how many training reviews belong to each class.\n",
        "    class_counts = labels.value_counts()\n",
        "\n",
        "    # Count the total number of training reviews.\n",
        "    total_reviews = len(labels)\n",
        "\n",
        "    # Probability of each class = its count / total reviews.\n",
        "    priors = {\n",
        "        0: class_counts.get(0, 0) / total_reviews,\n",
        "        1: class_counts.get(1, 0) / total_reviews\n",
        "    }\n",
        "\n",
        "    return priors\n",
        "\n",
        "def count_tokens(tokenized_reviews, labels):\n",
        "    # Separate token counters for negative and positive reviews.\n",
        "    word_counts = {\n",
        "        0: Counter(),\n",
        "        1: Counter()\n",
        "    }\n",
        "\n",
        "    # Store every unique training token.\n",
        "    vocabulary = set()\n",
        "\n",
        "    for tokens, label in zip(tokenized_reviews, labels):\n",
        "        # Add this review's token frequencies to its class counter.\n",
        "        word_counts[label].update(tokens)\n",
        "\n",
        "        # Add its tokens to the shared vocabulary.\n",
        "        vocabulary.update(tokens)\n",
        "\n",
        "    return word_counts, vocabulary\n",
        "\n",
        "def calculate_likelihoods(word_counts, vocabulary):\n",
        "    # Store a probability for every vocabulary token in each class.\n",
        "    likelihoods = {0: {}, 1: {}}\n",
        "\n",
        "    vocab_size = len(vocabulary)\n",
        "\n",
        "    for label in [0, 1]:\n",
        "        # Count all token occurrences in this class.\n",
        "        total_tokens = sum(word_counts[label].values())\n",
        "\n",
        "        for word in vocabulary:\n",
        "            # Apply the professor's required add-1 smoothing.\n",
        "            probability = (\n",
        "                (word_counts[label][word] + 1)\n",
        "                / (total_tokens + vocab_size)\n",
        "            )\n",
        "\n",
        "            likelihoods[label][word] = probability\n",
        "\n",
        "    return likelihoods"
      ]
    },
