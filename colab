        "import re\n",
        "\n",
        "def clean_text(text):\n",
        "    # Replace sentence and line-break tags with a period and space.\n",
        "    text = re.sub(\n",
        "        r\"<\\s*[/\\\\]?\\s*(?:br|s)\\s*[/\\\\]?\\s*>\",\n",
        "        \". \",\n",
        "        text,\n",
        "        flags=re.IGNORECASE\n",
        "    )\n",
        "\n",
        "    # Remove other HTML tags, keeping the text around them separated.\n",
        "    text = re.sub(r\"<[^>]+>\", \" \", text)\n",
        "\n",
        "    # Replace repeated spaces, tabs, and newlines with one space.\n",
        "    text = re.sub(r\"\\s+\", \" \", text)\n",
        "\n",
        "    # Remove spaces at the beginning and end.\n",
        "    return text.strip()\n",
        "\n",
        "def select_tokens(doc, lemmatize_words=True, remove_stop_words=True):\n",
        "    # Store the tokens we decide to keep.\n",
        "    tokens = []\n",
        "\n",
        "    for token in doc:\n",
        "        # Skip whitespace tokens.\n",
        "        if token.is_space:\n",
        "            continue\n",
        "\n",
        "        # Remove stop words only when this option is enabled.\n",
        "        # Keep punctuation, as required by the assignment.\n",
        "        if remove_stop_words and token.is_stop and not token.is_punct:\n",
        "            continue\n",
        "\n",
        "        # Choose the base form or the original text.\n",
        "        if lemmatize_words and not token.is_punct:\n",
        "            word = token.lemma_\n",
        "        else:\n",
        "            word = token.text\n",
        "\n",
        "        # Use lowercase consistently in all scenarios.\n",
        "        tokens.append(word.lower())\n",
        "\n",
        "    return tokens\n",
        "\n",
        "def preprocess_text(\n",
        "    text,\n",
        "    lemmatize_words=True,\n",
        "    remove_stop_words=True,\n",
        "    handle_logical_negation=True\n",
        "):\n",
        "    # Enforce the professor's restriction.\n",
        "    if handle_logical_negation and not lemmatize_words:\n",
        "        raise ValueError(\"Negation handling requires lemmatization.\")\n",
        "\n",
        "    # Clean tags and extra spaces, then process with spaCy.\n",
        "    doc = nlp(clean_text(text))\n",
        "\n",
        "    # Use our earlier helper when negation handling is disabled.\n",
        "    if not handle_logical_negation:\n",
        "        return select_tokens(doc, lemmatize_words, remove_stop_words)\n",
        "\n",
        "    tokens = []\n",
        "    negated = False\n",
        "    negation_words = {\"not\", \"n't\", \"never\", \"no\"}\n",
        "\n",
        "    for token in doc:\n",
        "        if token.is_space:\n",
        "            continue\n",
        "\n",
        "        # Preserve punctuation and end the negation scope.\n",
        "        if token.is_punct:\n",
        "            tokens.append(token.text)\n",
        "            negated = False\n",
        "            continue\n",
        "\n",
        "        # Detect negation BEFORE removing stop words.\n",
        "        if token.lower_ in negation_words:\n",
        "            negated = True\n",
        "            if not remove_stop_words:\n",
        "                tokens.append(token.lower_)\n",
        "            continue\n",
        "\n",
        "        if remove_stop_words and token.is_stop:\n",
        "            continue\n",
        "\n",
        "        word = token.lemma_.lower()\n",
        "\n",
        "        # Mark words inside the negation scope.\n",
        "        if negated:\n",
        "            word = \"NOT_\" + word\n",
        "\n",
        "        tokens.append(word)\n",
        "\n",
        "    return tokens"
      ]
    },
