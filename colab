        "## 9. Define the shared scenario runner\n",
        "\n",
        "This function calls the earlier functions in order. Training uses only training reviews and labels. Actual test labels are used only for evaluation. Every call rebuilds the model using its scenario's settings."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "929af8dc",
      "metadata": {
        "id": "929af8dc"
      },
      "outputs": [],
      "source": [
        "def run_scenario(train_df, test_df, lemmatize_words,\n",
        "                 remove_stop_words, handle_logical_negation):\n",
        "    settings = {\n",
        "        \"lemmatize_words\": lemmatize_words,\n",
        "        \"remove_stop_words\": remove_stop_words,\n",
        "        \"handle_logical_negation\": handle_logical_negation\n",
        "    }\n",
        "\n",
        "    # 1. Apply matching preprocessing to training and test reviews.\n",
        "    train_tokens = [preprocess_text(review, **settings)\n",
        "                    for review in train_df[\"text\"]]\n",
        "    test_tokens = [preprocess_text(review, **settings)\n",
        "                   for review in test_df[\"text\"]]\n",
        "\n",
        "    # 2. Learn probabilities and vocabulary from training data only.\n",
        "    priors = calculate_priors(train_df[\"label\"])\n",
        "    word_counts, vocabulary = count_tokens(train_tokens, train_df[\"label\"])\n",
        "    likelihoods = calculate_likelihoods(word_counts, vocabulary)\n",
        "\n",
        "    # 3. Perform sentiment analysis on the test reviews.\n",
        "    predictions = []\n",
        "    for tokens in test_tokens:\n",
        "        prediction, log_posteriors = predict_review(\n",
        "            tokens, priors, likelihoods, vocabulary\n",
        "        )\n",
        "        predictions.append(prediction)\n",
        "\n",
        "    # 4. Use actual test labels to evaluate the predictions.\n",
        "    results = test_df[[\"text\", \"label\"]].copy()\n",
        "    results = results.rename(columns={\"label\": \"Actual\"})\n",
        "    results[\"Predicted\"] = predictions\n",
        "    results[\"Correct\"] = results[\"Actual\"] == results[\"Predicted\"]\n",
        "    confusion = build_confusion_matrix(results[\"Actual\"], results[\"Predicted\"])\n",
        "    metrics = calculate_metrics(confusion)\n",
        "    accuracy = results[\"Correct\"].mean()\n",
        "\n",
        "    # 5. Show the outputs required for each scenario.\n",
        "    print(\"Training reviews:\", len(train_tokens))\n",
        "    print(\"Test reviews:\", len(test_tokens))\n",
        "    print(\"Class priors:\", priors)\n",
        "    print(\"Training vocabulary size:\", len(vocabulary))\n",
        "    print(\"Correct predictions:\", results[\"Correct\"].sum(), \"out of\", len(results))\n",
        "    display(confusion)\n",
        "    display(metrics.style.format({\n",
        "        \"Precision\": \"{:.2%}\", \"Recall\": \"{:.2%}\", \"F1\": \"{:.2%}\"\n",
        "    }))\n",
        "    print(f\"Accuracy: {accuracy:.2%}\")\n",
        "    return results, confusion, metrics, accuracy"
      ]
    },
